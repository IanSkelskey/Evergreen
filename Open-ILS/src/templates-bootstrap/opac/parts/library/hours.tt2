[%
   UNLESS TIME_FORMAT;
       TIME_FORMAT = '%l:%M %p';
   END;

   time_format = TIME_FORMAT;

   USE date (format = time_format);
   today = date.format(format = '%Y-%m-%d ');
   # We need to add "today" to the opening/closing hours for Date input

   # Evergreen stores dow_0 = Monday; strftime %w is 0 = Sunday.
   today_dow = (date.format(date.now, '%w') + 6) % 7;

   day_names = [ l('Monday'), l('Tuesday'), l('Wednesday'), l('Thursday'),
                 l('Friday'), l('Saturday'), l('Sunday') ];

   # Fragment identifiers from the GoodRelations vocabulary.  These form part
   # of a URI and so are deliberately not translated.
   day_uris = [ 'Monday', 'Tuesday', 'Wednesday', 'Thursday',
                'Friday', 'Saturday', 'Sunday' ];
-%]
<div class="mb-3">
<h2 class="library-heading">[% l('Opening hours') %]</h2>

<dl class="library-hours">
    [%- FOR day IN [0, 1, 2, 3, 4, 5, 6];
        open_key  = 'dow_' _ day _ '_open';
        close_key = 'dow_' _ day _ '_close';
        note_key  = 'dow_' _ day _ '_note';
        open  = today _ ctx.hours.$open_key;
        close = today _ ctx.hours.$close_key;
        note  = ctx.hours.$note_key;
        is_today = (day == today_dow);
    -%]
    <dt[% IF is_today %] class="is-today"[% END %]>[% day_names.$day %][% IF is_today %] <span class="sr-only">[% l('(today)') %]</span>[% END %]</dt>
    [%- IF open == close %]
    <dd class="opening-hours[% IF is_today %] is-today[% END %]">[% l('Closed') %]</dd>
    [%- ELSE %]
    <dd class="opening-hours[% IF is_today %] is-today[% END %]" property="openingHoursSpecification" typeof="OpeningHoursSpecification"><link property="dayOfWeek" href="http://purl.org/goodrelations/v1#[% day_uris.$day %]" />[%
        l('[_1] - [_2]', '<time property="opens" content="' _ date.format(open, format => '%H:%M:%S') _ '">' _ date.format(open) _ '</time>',
         '<time property="closes" content="' _ date.format(close, format => '%H:%M:%S') _ '">' _ date.format(close) _ '</time>')
    -%][%- IF note %] <span>[% l('([_1])', note) %]</span>[% END %]</dd>
    [%- END %]
    [%- END %]
</dl>
</div>

<h2 class="library-heading">[% l('Upcoming closures') %]</h2>

[% IF ctx.closed_dates.size %]
    <table role="table" title="[% l('Closed Dates') %]" class="table w-auto">
    <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">[% l('Date') %]</th>
          <th scope="col" role="columnheader">[% l('Reason for Closure') %]</th>
        </tr>
    </thead>
    <tbody role="rowgroup">
    [% FOR cdate IN ctx.closed_dates %]
    <tr role="row">
        <td role="cell">
            [% display_start_date = date.format(ctx.parse_datetime(cdate.close_start), DATE_FORMAT) %]
            [% display_end_date = date.format(ctx.parse_datetime(cdate.close_end), DATE_FORMAT) %]
            [% display_start_time = date.format(ctx.parse_datetime(cdate.close_start), TIME_FORMAT) %]
            [% display_end_time = date.format(ctx.parse_datetime(cdate.close_end), TIME_FORMAT) %]

            [% display_start_date %]
            [% IF cdate.full_day == 'f'; %]
                [% display_start_time %] -
                [% IF display_start_date != display_end_date %]
                    [% display_end_date %]
                [% END %]
                [% display_end_time %]
            [% END %]
            [% IF cdate.multi_day == 't' %]
                - [% display_end_date %]
            [% END %]
        </td>
        <td role="cell">[% cdate.reason | html %]</td>
    </tr>
    [% END %]
    </tbody>
    </table>
[% ELSE %]
        [% l("No closures scheduled") %]
[% END; %]
